generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id       String @id @default(cuid())
  
  email    String @unique
  password String

  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model User {
  id        String  @id @default(cuid())
  name      String
  age       Int?
  sex       String?
  treatment String?
  profile   String? // LLM generated profile

  account   Account?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states    State[]
}

model State {
  id           String   @id @default(cuid())
  userId       String
  dateCreated  DateTime @db.Date @default(now())

  user      User @relation(fields:[userId], references:[id])
  
  exercise     ExerciseModule?
  nutrition    NutritionModule?

  @@unique([userId, dateCreated])
}

// --- EXERCISE ---
model ExerciseModule {
  id          String    @id @default(cuid())
  stateId     String    @unique
  state       State @relation(fields: [stateId], references: [id])
  
  summary     String?
  plan       Json
  
  progress     ExerciseProgress?
}

model ExerciseProgress {
  id          String         @id @default(cuid())
  moduleId    String         @unique
  module      ExerciseModule @relation(fields: [moduleId], references: [id])
  
  summary     String?
  trackables  Json
}

// --- NUTRITION ---
model NutritionModule {
  id          String    @id @default(cuid())
  stateId     String    @unique
  state       State @relation(fields: [stateId], references: [id])
  
  summary     String?
  plan       Json      
  checklists  Json?     
  
  progress     NutritionProgress?
}

model NutritionProgress {
  id          String          @id @default(cuid())
  moduleId    String         @unique
  module      NutritionModule @relation(fields: [moduleId], references: [id])
  
  summary     String?
  trackables  Json
  checklistState Json?
}