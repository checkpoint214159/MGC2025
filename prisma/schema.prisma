generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  assistant
  system
}

enum UserRole {
  patient
  admin
  physiotherapist
  dietician
}

enum PlanStatus {
  draft
  verified
  active
  archived
}

enum FlagStatus {
  open
  reviewing
  escalated
  dismissed
}

model Account {
  id String @id @default(cuid())

  email    String @unique
  password String

  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model User {
  id   String @id @default(cuid())
  name String
  role UserRole @default(patient) // patient or admin (doctor)

  biometric     Biometrics?
  baseline     Baseline?
  queryBaseline Json?

  profile String? // LLM generated profile

  account   Account?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states    State[]
  threads   Thread[]
  externals External[]

  // Admin relations: one doctor manages many patients
  adminManagedPatients AdminPatientRelation[] @relation("AdminToPatients")
  // Back-relation for patient to know which admin manages them
  managedByAdmin       AdminPatientRelation? @relation("PatientToAdmin")

  flags Flag[] @relation("PatientFlags")
}

model AdminPatientRelation {
  id        String @id @default(cuid())
  adminId   String
  patientId String @unique

  admin   User @relation("AdminToPatients", fields: [adminId], references: [id], onDelete: Cascade)
  patient User @relation("PatientToAdmin", fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([adminId, patientId])
}

model Baseline {
  id   String @id @default(cuid())
  data Json

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Biometrics {
  id          String   @id @default(cuid())
  age         Int
  sex         String
  treatment   String
  surgeryDate DateTime
  // weightKg  Decimal
  // heightCm  Decimal

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model State {
  id          String   @id @default(cuid())
  userId      String
  dateCreated DateTime @db.Date

  createdAt DateTime @default(now())

  isActive Boolean

  // recovery plan / arc fields. The anchor State (isAnchor) is the stable
  // plan-of-record carrying the X-day arc + lifecycle; daily states track it.
  recoveryDays Int?
  status       PlanStatus @default(active)
  confidence   Float?
  isAnchor     Boolean    @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // links to states that created it / it helped create
  causalStateId String? @unique
  causalState   State?  @relation("StateHistory", fields: [causalStateId], references: [id])
  nextStateId   String? @unique
  nextState     State?  @relation("StateHistory") // Back-relation for Prisma

  // anchor plan-of-record this daily state tracks (many daily -> one anchor)
  anchorStateId  String?
  anchorState    State?  @relation("StateAnchor", fields: [anchorStateId], references: [id])
  trackingStates State[] @relation("StateAnchor")

  // links to X that created it
  causalXId String?   @unique
  causalX   External? @relation(fields: [causalXId], references: [id])

  // all modules attached to the state
  modules Module[]
}

model Module {
  id      String @id @default(cuid())
  type    String
  stateId String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  summary    String?
  plan       Json
  checklists Json?

  // clinical verification (S3): PT owns exercise, DT owns nutrition
  ownerRole    UserRole?
  verifiedAt   DateTime?
  verifiedById String?

  progress Progress?
  comments ModuleComment[]
}

model Progress {
  id       String @id @default(cuid())
  moduleId String @unique
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  summary        String?
  trackables     Json
  checklistState Json?
}

model External {
  // TODO: add other fields, right now only houses threadContext
  id     String @id @default(cuid())
  userId String

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateCreated DateTime @default(now()) @db.Date

  // here maybe some field for doctor input / update / advice / check-in
  // doctorMessage String?

  threadContext Json // redundancy but safety. lock an instance of thread once it is saved to external
  profile       String

  state State[]
}

model Thread {
  // MUTABLE. should not be directly consumed by immutables like External
  // since this will lead to versioning issues
  id     String  @id @default(cuid())
  userId String
  title  String? // e.g., "Post-Op Onboarding" or "Daily Symptom Log"
  type   String // 'onboarding', 'chat', 'doctor_note'

  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String @id @default(cuid())
  creationSource String // e.g created by what component, by onboarding? chat?  etc
  threadId       String
  role           Role // 'user' | 'assistant' | 'system'
  content        String

  context Json?

  // explainability?
  reasoning String?

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Clinician inline comments on a module during verification (S3)
model ModuleComment {
  id       String   @id @default(cuid())
  moduleId String
  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  authorId String
  role     UserRole
  body     String
  createdAt DateTime @default(now())
}

// Human-in-the-loop flag raised when recovery stalls (S7), e.g. pain not decreasing
model Flag {
  id           String     @id @default(cuid())
  patientId    String
  patient      User       @relation("PatientFlags", fields: [patientId], references: [id], onDelete: Cascade)
  type         String // e.g. "pain_stagnation"
  severity     String // "low" | "medium" | "high"
  status       FlagStatus @default(open)
  detail       Json?
  note         String?
  createdAt    DateTime   @default(now())
  resolvedAt   DateTime?
  resolvedById String?
}
