generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  assistant
  system
}

model Account {
  id       String @id @default(cuid())
  
  email    String @unique
  password String

  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model User {
  id        String  @id @default(cuid())
  name      String
  
  biometric Biometrics?
  profile   String? // LLM generated profile

  account   Account?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states    State[]
  threads   Thread[]
}

// update this on the fly
model Biometrics {
  id        String  @id @default(cuid())
  age       Int
  sex       String
  treatment String
  surgeryDate  DateTime
  // weightKg  Decimal
  // heightCm  Decimal

  userId    String  @unique
  user      User @relation(fields:[userId], references:[id], onDelete: Cascade)
}

model State {
  id           String   @id @default(cuid())
  userId       String
  dateCreated  DateTime @db.Date @default(now())

  isActive      Boolean

  user      User @relation(fields:[userId], references:[id], onDelete: Cascade)
  
  causalStateId String?  @unique
  causalState   State?   @relation("StateHistory", fields: [causalStateId], references: [id])
  nextStateId   String?  @unique
  nextState     State?   @relation("StateHistory") // Back-relation for Prisma
  
  causalXId     String?  @unique
  causalX       External? @relation(fields: [causalXId], references: [id])

  exercise     ExerciseModule?
  nutrition    NutritionModule?

  @@unique([userId, dateCreated, isActive])
}

// --- EXERCISE ---
model ExerciseModule {
  id          String    @id @default(cuid())
  stateId     String    @unique
  state       State @relation(fields: [stateId], references: [id])
  
  summary     String?
  plan       Json
  
  progress     ExerciseProgress?
}

model ExerciseProgress {
  id          String         @id @default(cuid())
  moduleId    String         @unique
  module      ExerciseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  summary     String?
  trackables  Json
}

// --- NUTRITION ---
model NutritionModule {
  id          String    @id @default(cuid())
  stateId     String    @unique
  state       State @relation(fields: [stateId], references: [id], onDelete: Cascade)
  
  summary     String?
  plan       Json      
  checklists  Json?     
  
  progress     NutritionProgress?
}

model NutritionProgress {
  id          String          @id @default(cuid())
  moduleId    String         @unique
  module      NutritionModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  summary     String?
  trackables  Json
  checklistState Json?
}


model External {
  // TODO: add other fields, right now only houses threadContext
  id          String          @id @default(cuid())
  dateCreated DateTime @db.Date @default(now())

  // here maybe some field for doctor input / update / advice / check-in
  // doctorMessage String?

  threadContext Json   // redundancy but safety. we aren't looking at mutable threads 
  
  messageCount Int?
  threadCount  Int?

  state        State?
}

model Thread {
  // MUTABLE. should not be directly consumed by immutables like External
  // since this will lead to versioning issues
  id        String   @id @default(cuid())
  userId    String
  title     String?  // e.g., "Post-Op Onboarding" or "Daily Symptom Log"
  type      String   // 'onboarding', 'chat', 'doctor_note'
  
  user      User     @relation(fields: [userId], references: [id])
  messages  Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  creationSource    String   // e.g created by what component, by onboarding? chat?  etc
  threadId  String
  role      Role   // 'user' | 'assistant' | 'system'
  content   String   
  
  context  Json?    
  
  // explainability?
  reasoning String?  

  thread    Thread   @relation(fields: [threadId], references: [id])
  createdAt DateTime @default(now())

}

