generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  assistant
  system
}

enum UserRole {
  patient
  admin
}

model Account {
  id String @id @default(cuid())

  email    String @unique
  password String

  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model User {
  id   String @id @default(cuid())
  name String
  role UserRole @default(patient) // patient or admin (doctor)

  biometric     Biometrics?
  baseline     Baseline?
  queryBaseline Json?

  profile String? // LLM generated profile

  account   Account?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states    State[]
  threads   Thread[]
  externals External[]

  // Admin relations: one doctor manages many patients
  adminManagedPatients AdminPatientRelation[] @relation("AdminToPatients")
  // Back-relation for patient to know which admin manages them
  managedByAdmin       AdminPatientRelation? @relation("PatientToAdmin")
}

model AdminPatientRelation {
  id        String @id @default(cuid())
  adminId   String
  patientId String @unique

  admin   User @relation("AdminToPatients", fields: [adminId], references: [id], onDelete: Cascade)
  patient User @relation("PatientToAdmin", fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([adminId, patientId])
}

model Baseline {
  id   String @id @default(cuid())
  data Json

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Biometrics {
  id          String   @id @default(cuid())
  age         Int
  sex         String
  treatment   String
  surgeryDate DateTime
  // weightKg  Decimal
  // heightCm  Decimal

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model State {
  id          String   @id @default(cuid())
  userId      String
  dateCreated DateTime @db.Date

  createdAt DateTime @default(now())

  isActive Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // links to states that created it / it helped create
  causalStateId String? @unique
  causalState   State?  @relation("StateHistory", fields: [causalStateId], references: [id])
  nextStateId   String? @unique
  nextState     State?  @relation("StateHistory") // Back-relation for Prisma

  // links to X that created it
  causalXId String?   @unique
  causalX   External? @relation(fields: [causalXId], references: [id])

  // all modules attached to the state
  modules Module[]
}

model Module {
  id      String @id @default(cuid())
  type    String
  stateId String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  summary    String?
  plan       Json
  checklists Json?

  progress Progress?
}

model Progress {
  id       String @id @default(cuid())
  moduleId String @unique
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  summary        String?
  trackables     Json
  checklistState Json?
}

model External {
  // TODO: add other fields, right now only houses threadContext
  id     String @id @default(cuid())
  userId String

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateCreated DateTime @default(now()) @db.Date

  // here maybe some field for doctor input / update / advice / check-in
  // doctorMessage String?

  threadContext Json // redundancy but safety. lock an instance of thread once it is saved to external
  profile       String

  state State[]
}

model Thread {
  // MUTABLE. should not be directly consumed by immutables like External
  // since this will lead to versioning issues
  id     String  @id @default(cuid())
  userId String
  title  String? // e.g., "Post-Op Onboarding" or "Daily Symptom Log"
  type   String // 'onboarding', 'chat', 'doctor_note'

  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String @id @default(cuid())
  creationSource String // e.g created by what component, by onboarding? chat?  etc
  threadId       String
  role           Role // 'user' | 'assistant' | 'system'
  content        String

  context Json?

  // explainability?
  reasoning String?

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model GraphConfig {
  graphName           String   @id @unique // e.g., "state-generation"
  contextWindowDays   Int      @default(1)     // 1=yesterday, N=last N days, -1=all
  smartFiltering      Boolean  @default(false) // Filter states for relevance
  maxContextTokens    Int      @default(8000)  // Token limit for LLM context
  includeTrajectory   Boolean  @default(false) // Summary instead of full history
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
